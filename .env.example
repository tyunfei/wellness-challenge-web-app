# Local defaults only; never commit actual .env credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=REPLACE_WITH_YOUR_LOCAL_MYSQL_PASSWORD
DB_DATABASE=wellness_challenge

JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=1h
JWT_ALGORITHM=HS256
NODE_ENV=development
# Railway provides PORT automatically.
PORT=3000
