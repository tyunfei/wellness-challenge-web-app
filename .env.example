# Copy to .env and replace placeholders; never commit .env.
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=REPLACE_WITH_YOUR_LOCAL_MYSQL_PASSWORD
DB_DATABASE=wellness_challenge

# Generate a long, random secret for local use.
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=1h
JWT_ALGORITHM=HS256
